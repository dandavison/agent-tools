#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Run a prompt non-interactively on a model chosen by agent-pick.

    agent run [-p|-w] [-m MODEL] [-e EFFORT]                  prompt from stdin, or typed at the terminal
    agent run [-p|-w] [-m MODEL] [-e EFFORT] FILE [ARG...]    prompt script; ARGs and stdin are appended
    agent run --print-prompt FILE [ARG...]                print the prompt instead of running it

A prompt script starts with e.g. `#!/usr/bin/env -S agent run -w -m luna`. -p/-w choose the
account even in a directory that agent-models.toml gives to the other one; without them, the
account is chosen by the directory, as for a session. The model is
$AGENT_MODEL if set, else -m MODEL, else chosen with fzf if there is a terminal; likewise the
effort ($AGENT_EFFORT, -e EFFORT), for a model with efforts.
The answer goes to stdout; tool calls and cost go to stderr. --no-tools disables tools for
claude and pi; codex cannot disable them, so it gets a read-only sandbox instead.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import IO, Any

DIM, RESET = ("\x1b[2m", "\x1b[0m") if sys.stderr.isatty() else ("", "")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    accounts = parser.add_mutually_exclusive_group()
    accounts.add_argument("-p", "--personal", action="store_true")
    accounts.add_argument("-w", "--work", action="store_true")
    parser.add_argument("-m", dest="model")
    parser.add_argument("-e", dest="effort")
    parser.add_argument("--no-tools", action="store_true")
    parser.add_argument("--print-prompt", action="store_true")
    parser.add_argument("file", nargs="?", type=Path)
    parser.add_argument("args", nargs="*")
    args = parser.parse_args()
    if args.print_prompt:
        print(script_prompt(args.file, args.args))
        return

    account = "personal" if args.personal else "work" if args.work else None
    pick = pick_model(args.model, args.effort, account)
    os.environ.update(pick["env"])
    prompt = script_prompt(args.file, args.args) if args.file else terminal_prompt()
    run = {"claude": run_claude, "codex": run_codex, "pi": run_pi}[pick["cli"]]
    sys.exit(run(pick, prompt, args.no_tools))


def pick_model(
    name: str | None, effort: str | None, account: str | None
) -> dict[str, Any]:
    if not (name or os.environ.get("AGENT_MODEL")) and not sys.stderr.isatty():
        sys.exit("agent run: no model: set AGENT_MODEL or pass -m")
    effort = os.environ.get("AGENT_EFFORT") or effort
    result = subprocess.run(
        [
            "agent-pick",
            *([f"--{account}", "--anywhere"] if account else []),
            *(["-e", effort] if effort else []),
            *([] if sys.stderr.isatty() else ["--no-fzf"]),
            *([name] if name else []),
        ],
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.exit(result.returncode)
    return json.loads(result.stdout)


def script_prompt(file: Path, args: list[str]) -> str:
    lines = file.read_text().splitlines(keepends=True)
    prompt = "".join(lines[1:] if lines and lines[0].startswith("#!") else lines)
    if args:
        prompt += f"\n\nArguments: {' '.join(args)}"
    stdin = "" if sys.stdin.isatty() else sys.stdin.read()
    if stdin:
        prompt += f"\n\nInput:\n{stdin}"
    return prompt


def terminal_prompt() -> str:
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return subprocess.run(
        ["rlwrap", "cat"], stdout=subprocess.PIPE, text=True, check=True
    ).stdout


def run_claude(pick: dict[str, Any], prompt: str, no_tools: bool) -> int:
    cmd = ["claude", *pick["args"], "--print", "--no-session-persistence"]
    cmd += ["--tools", ""] if no_tools else []
    cmd += ["--output-format", "stream-json", "--verbose", prompt]
    with subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True) as proc:
        progress = Progress()
        for event in events(proc.stdout):
            if event["type"] == "assistant":
                for block in event["message"].get("content", []):
                    if block["type"] == "text":
                        progress.answer(block["text"])
                    elif block["type"] == "tool_use":
                        progress.tool(block["name"], tool_detail(block["input"]))
            elif event["type"] == "result":
                cost = event.get("total_cost_usd") or 0
                progress.done(
                    f"{event['subtype']}, {event['num_turns']} turns, ${cost:.4g}"
                )
    return proc.returncode


def run_codex(pick: dict[str, Any], prompt: str, no_tools: bool) -> int:
    cmd = ["codex", "exec", *pick["args"], "--skip-git-repo-check"]
    cmd += ["--sandbox", "read-only"] if no_tools else []
    cmd += ["--ephemeral", "--json", prompt]
    # Codex logs to stderr; its errors also appear as events in the JSON stream.
    with subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    ) as proc:
        progress = Progress()
        for event in events(proc.stdout):
            item = event.get("item", {})
            if event["type"] == "item.started":
                progress.tool(item["type"], item.get("command", ""))
            elif event["type"] == "item.completed" and item["type"] == "agent_message":
                progress.answer(item["text"])
            elif event["type"] == "item.completed" and item["type"] == "error":
                progress.note(f"[error: {item['message']}]")
            elif event["type"] == "turn.failed":
                progress.done(f"failed: {event['error']['message']}")
            elif event["type"] == "turn.completed":
                progress.done(codex_usage(event["usage"], pick["price"]))
    return proc.returncode


def run_pi(pick: dict[str, Any], prompt: str, no_tools: bool) -> int:
    cmd = ["pi", *pick["args"], "--print", "--no-session"]
    cmd += ["--no-tools"] if no_tools else []
    cmd += [prompt]
    return subprocess.run(cmd, check=False).returncode


def events(stdout: IO[str] | None) -> Any:
    assert stdout is not None
    for line in stdout:
        yield json.loads(line)


def tool_detail(tool_input: dict[str, Any]) -> str:
    for key in ("command", "file_path", "path", "pattern", "skill", "url", "query"):
        if key in tool_input:
            return " ".join(str(tool_input[key]).split())
    return ""


def codex_usage(usage: dict[str, int], price: dict[str, float] | None) -> str:
    if price is None:
        return f"{usage['input_tokens'] + usage['output_tokens']} tokens"
    cached, written = usage["cached_input_tokens"], usage["cache_write_input_tokens"]
    cost = (
        (usage["input_tokens"] - cached - written) * price["input"]
        + cached * price["cached_input"]
        + written * price["cache_write"]
        + usage["output_tokens"] * price["output"]
    ) / 1e6
    return f"${cost:.4g}"


class Progress:
    """Answer text to stdout; one line per tool call and status to stderr."""

    def answer(self, text: str) -> None:
        print(text, flush=True)

    def tool(self, name: str, detail: str = "") -> None:
        width = shutil.get_terminal_size().columns
        line = f"[tool: {name}] {detail}".rstrip()
        self.note(line if len(line) <= width else line[: width - 1] + "…")

    def note(self, text: str) -> None:
        print(f"{DIM}{text}{RESET}", file=sys.stderr, flush=True)

    def done(self, summary: str) -> None:
        self.note(f"--- done: {summary} ---")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
