#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Choose a model from ~/.config/agent-models.toml and print it as JSON.

The model is $AGENT_MODEL if set, else NAME, else chosen with fzf. Then, for a model with
`efforts`, the effort is $AGENT_EFFORT if set, else -e EFFORT, else chosen with fzf, starting on
the model's default `effort` (with --no-fzf, the default is used without asking). It is always
passed to the CLI, so that a CLI's own saved default (e.g. from claude's /effort) never applies.

The account (work or personal) is the one whose `paths` contain the repo's main checkout
(the parent of its git common dir, so a worktree counts as its repo), or the current directory
outside a repo. -p/-w must agree with that, and are required where no account's paths match.
With --anywhere, -p/-w override the paths, for prompt scripts whose directory is incidental.

Output: {"name", "cli", "model", "account", "effort", "args", "env", "price"}, where args
are the CLI's arguments for the model and effort, env holds the account's variables, and price is the model's USD per million tokens (from the OpenRouter model list
cached by agent-prices-refresh), or null if the model has no `openrouter` id.
Models with a `health` URL are offered only if that URL responds.
For a claude model, fails if the account's login store is logged in to an org other than the
account's claude_org, so that a /login to the wrong account does not go unnoticed.
"""

import argparse
import json
import os
import subprocess
import sys
import tomllib
import urllib.request
from decimal import Decimal
from pathlib import Path
from typing import Any

CONFIG_PATH = Path(
    os.environ.get("AGENT_MODELS", "~/.config/agent-models.toml")
).expanduser()
PRICES_PATH = Path(
    os.environ.get("AGENT_PRICES", "~/.cache/agent-prices/openrouter-models.json")
).expanduser()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?")
    flags = parser.add_mutually_exclusive_group()
    flags.add_argument("-p", "--personal", action="store_true")
    flags.add_argument("-w", "--work", action="store_true")
    parser.add_argument(
        "--anywhere", action="store_true", help="-p/-w override the account paths"
    )
    parser.add_argument("-e", dest="effort", help="one of the model's efforts")
    parser.add_argument("--no-fzf", action="store_true", help="fail instead of asking")
    parser.add_argument("--list", action="store_true", help="print available models")
    args = parser.parse_args()

    config = tomllib.loads(CONFIG_PATH.read_text())
    models = [m for m in config["models"] if is_available(m)]
    if args.list:
        print(format_rows(models), end="")
        return
    accounts = config.get("accounts", {})
    flag = "personal" if args.personal else "work" if args.work else None
    account = choose_account(accounts, flag, args.anywhere)
    name = os.environ.get("AGENT_MODEL") or args.name
    model = find(models, name or fzf(format_rows(models), f"account: {account}"))
    effort = choose_effort(
        model, os.environ.get("AGENT_EFFORT") or args.effort, args.no_fzf
    )
    settings = accounts.get(account, {})
    env = {k: str(Path(v).expanduser()) for k, v in settings.get("env", {}).items()}
    if model["cli"] == "claude" and "claude_org" in settings:
        check_claude_org(account, settings["claude_org"], env)
    print(
        json.dumps(
            {
                "name": model["name"],
                "cli": model["cli"],
                "model": model["model"],
                "account": account,
                "effort": effort,
                "args": cli_args(model, effort),
                "env": env,
                "price": price(model["openrouter"]) if "openrouter" in model else None,
            }
        )
    )


def choose_effort(
    model: dict[str, Any], effort: str | None, no_fzf: bool
) -> str | None:
    efforts = model.get("efforts", [])
    if not efforts:
        if effort:
            sys.exit(f"agent pick: {model['name']} has no efforts")
        return None
    default = model.get("effort")
    if default and default not in efforts:
        sys.exit(f"agent pick: {model['name']} default effort {default} is not in its efforts")
    if not effort and no_fzf:
        if not default:
            sys.exit(
                f"agent pick: no effort for {model['name']}: set AGENT_EFFORT or pass -e"
            )
        effort = default
    effort = effort or fzf(
        "".join(f"{e}\n" for e in efforts),
        f"{model['name']} effort",
        efforts.index(default) + 1 if default else 1,
    )
    if effort not in efforts:
        sys.exit(
            f"agent pick: {model['name']} efforts are {', '.join(efforts)}, not {effort}"
        )
    return effort


def cli_args(model: dict[str, Any], effort: str | None) -> list[str]:
    args = ["--model", model["model"]]
    if effort and model["cli"] == "claude":
        args += ["--effort", effort]
    elif effort and model["cli"] == "codex":
        args += ["-c", f"model_reasoning_effort={effort}"]
    elif effort:
        sys.exit(f"agent pick: efforts are not supported for {model['cli']}")
    return args


def choose_account(accounts: dict[str, Any], flag: str | None, anywhere: bool) -> str:
    if flag and anywhere:
        return flag
    checkout = main_checkout()
    matched = next(
        (
            name
            for name, settings in accounts.items()
            for path in settings.get("paths", [])
            if is_within(checkout, Path(path).expanduser().resolve())
        ),
        None,
    )
    if flag and matched and flag != matched:
        sys.exit(
            f"agent pick: {checkout} is in the {matched} account's paths, not {flag}'s"
            " (see [accounts] in agent-models.toml)"
        )
    account = flag or matched
    if not account:
        sys.exit(
            f"agent pick: {checkout} is in no account's paths; pass -p (personal) or -w"
            " (work), or add it to [accounts] in agent-models.toml"
        )
    return account


def main_checkout() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        return Path.cwd().resolve()
    return Path(result.stdout.strip()).resolve().parent


def is_within(path: Path, dir: Path) -> bool:
    return path == dir or dir in path.parents


def check_claude_org(account: str, expected: str, env: dict[str, str]) -> None:
    config_dir = env.get("CLAUDE_CONFIG_DIR")
    store = (
        Path(config_dir) / ".claude.json"
        if config_dir
        else Path.home() / ".claude.json"
    )
    if not store.exists():
        return
    oauth = json.loads(store.read_text()).get("oauthAccount") or {}
    org = oauth.get("organizationUuid")
    if org and org != expected:
        sys.exit(
            f"agent pick: {store} is logged in to org {org} ({oauth.get('emailAddress')}),"
            f" but the {account} account's org is {expected}.\n"
            f"Run /login in: {' '.join([*(f'{k}={v}' for k, v in env.items()), 'claude'])}"
        )


def is_available(model: dict[str, Any]) -> bool:
    if "health" not in model:
        return True
    try:
        urllib.request.urlopen(model["health"], timeout=0.5)
        return True
    except OSError:
        return False


def format_rows(models: list[dict[str, Any]]) -> str:
    width = max((len(m["name"]) for m in models), default=0)
    return "".join(
        f"{m['name']:<{width}}  {m['cli']:<6}  {m['model']}\n" for m in models
    )


def price(openrouter_id: str) -> dict[str, float]:
    if not PRICES_PATH.exists():
        sys.exit(f"agent pick: {PRICES_PATH} not found; run agent prices-refresh")
    for entry in json.loads(PRICES_PATH.read_text())["data"]:
        if entry["id"] == openrouter_id:
            per_token = entry["pricing"]
            return {
                key: float(Decimal(per_token[openrouter_key]) * 1_000_000)
                for key, openrouter_key in [
                    ("input", "prompt"),
                    ("cached_input", "input_cache_read"),
                    ("cache_write", "input_cache_write"),
                    ("output", "completion"),
                ]
            }
    sys.exit(f"agent pick: {openrouter_id} not in {PRICES_PATH}")


def fzf(rows: str, header: str, pos: int = 1) -> str:
    result = subprocess.run(
        [
            "fzf",
            "--height=~40%",
            "--reverse",
            f"--header={header}",
            "--bind",
            f"load:pos({pos})",
        ],
        input=rows,
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        sys.exit(result.returncode)
    return result.stdout.split()[0]


def find(models: list[dict[str, Any]], name: str) -> dict[str, Any]:
    for model in models:
        if model["name"] == name:
            return model
    sys.exit(f"agent pick: model not available: {name}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
