#!/bin/zsh
# Run: shell/tests/test-agent-question
set -eu

export AGENT_MODELS=$(mktemp)
trap 'rm -f $AGENT_MODELS' EXIT
cat > $AGENT_MODELS <<'EOF'
[[models]]
name = "luna"
cli = "codex"
model = "gpt-6-luna"
EOF

source "${0:A:h:h}/zsh/agent.zsh"

[[ $(agent-question-command "what's in *.txt? |") = "agent-run <<< 'what'\\''s in *.txt?'" ]]
[[ $(agent-question-command "fix the build|  ") = "agent-run <<< 'fix the build'" ]]
[[ $(agent-question-command "explain this | luna") = "agent-run -m luna <<< 'explain this'" ]]
[[ $(agent-question-command "ls | less") = "" ]]
[[ $(agent-question-command "echo '|'") = "" ]]
[[ $(agent-question-command "true ||") = "" ]]
[[ $(agent-question-command "|") = "" ]]
