#!/bin/zsh
# Run: tests/test-agent-text
set -eu

export AGENT_MODELS=$(mktemp)
trap 'rm -f $AGENT_MODELS $recorded' EXIT
cat > $AGENT_MODELS <<'EOF'
[[models]]
name = "luna"
cli = "codex"
model = "gpt-6-luna"
EOF

source "${0:A:h:h}/shell/agent.zsh"

[[ $(agent-text-command "what's in *.txt? |") = "agent-run <<< 'what'\\''s in *.txt?'" ]]
[[ $(agent-text-command "fix the build|  ") = "agent-run <<< 'fix the build'" ]]
[[ $(agent-text-command "explain this | luna") = "agent-run -m luna <<< 'explain this'" ]]
[[ $(agent-text-command "ls | less") = "" ]]
[[ $(agent-text-command "echo '|'") = "" ]]
[[ $(agent-text-command "true ||") = "" ]]
[[ $(agent-text-command "|") = "" ]]

zle() { : }
BUFFER=""
[[ -z $(agent-accept-line 2>&1) ]]

# Ctrl-X Ctrl-A replaces the text in place, prints nothing, and records the text in atuin history.
recorded=$(mktemp)
agent-pick() { print -r -- '{"name": "luna"}' }
agent-suggest-command() { [[ $AGENT_MODEL = luna ]] && print -r -- "ls *.jpg"; print -u2 -- "--- done ---" }
atuin() { [[ "$1 $2" = "history start" ]] && print -r -- $4 >> $recorded && print -r -- id1; true }
BUFFER="list toucan photos"
output=$(agent-suggest-command-widget 2>&1; print -r -- "$BUFFER|$(<$recorded)")
[[ $output = "ls *.jpg|list toucan photos" ]]

# Tab directly after a trailing "|" replaces the text with a suggested command; otherwise Tab completes.
zle() { print -r -- "zle $*" }
BUFFER="list toucan photos |"
LBUFFER=$BUFFER RBUFFER=
[[ $({ agent-tab-widget; print -r -- "$BUFFER" } 2>&1 | grep -v '^zle ') = "ls *.jpg" ]]
for text in "ls | " "true ||" "|" "echo toucan"; do
    BUFFER=$text
    LBUFFER=$BUFFER RBUFFER=
    [[ $(agent-tab-widget; print -r -- "$BUFFER") = "zle expand-or-complete"$'\n'"$text" ]]
done
