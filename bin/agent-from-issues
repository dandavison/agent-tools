#!/bin/bash
#
# agent-from-issues [-R owner/repo] [--personal] [-m MODEL] <issue-number-or-url>... [-- <agent> [<arg>...]]
#
# Start an interactive agent session via agent-with-input, which chooses the
# model, with the input buffer pre-seeded with the content of the given GitHub
# issues (fetched via gh-issue-to-md). Nothing is submitted.
#
# All issues plus their labels go into a single paste, so the labels are
# collapsed into the placeholder along with the content rather than being
# visible in the pane.
#
# ~/.config/agent-from-issues.toml (or $AGENT_FROM_ISSUES_CONFIG) may contain
#   default_repo = "owner/repo"      # repo for bare issue numbers
#   [labels]
#   "owner/repo" = "my notes repo"   # how issues from that repo are described

set -euo pipefail

config=${AGENT_FROM_ISSUES_CONFIG:-~/.config/agent-from-issues.toml}

toml_get() {
    [[ -f "$config" ]] || return 0
    uv run --no-project --quiet --python '>=3.11' python -c '
import sys, tomllib
value = tomllib.load(open(sys.argv[1], "rb"))
for key in sys.argv[2:]:
    value = value.get(key) if isinstance(value, dict) else None
print(value or "")' "$config" "$@"
}

repo=$(toml_get default_repo)
issues=()
with_input_args=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-R" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Error: -R requires an argument" >&2
            exit 1
        fi
        repo="$2"
        shift 2
    elif [[ "$1" == "--personal" ]]; then
        with_input_args+=(--personal)
        shift
    elif [[ "$1" == "-m" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Error: -m requires an argument" >&2
            exit 1
        fi
        with_input_args+=(-m "$2")
        shift 2
    elif [[ "$1" == "--" ]]; then
        with_input_args+=("$@")
        break
    else
        issues+=("$1")
        shift
    fi
done

if [[ ${#issues[@]} -eq 0 ]]; then
    echo "Usage: agent-from-issues [-R owner/repo] [--personal] [-m MODEL] <issue-number-or-url>... [-- <agent> [<arg>...]]" >&2
    exit 1
fi

urls=()
labels=()
for item in "${issues[@]}"; do
    if [[ "$item" =~ github\.com/([^/]+)/([^/]+)/issues/([0-9]+) ]]; then
        item_owner="${BASH_REMATCH[1]}"
        item_repo="${BASH_REMATCH[2]}"
        item_num="${BASH_REMATCH[3]}"
        full_repo="$item_owner/$item_repo"
        url="https://github.com/$full_repo/issues/$item_num"
    elif [[ "$item" =~ ^#?([0-9]+)$ ]]; then
        if [[ -z "$repo" ]]; then
            echo "Error: issue '$item' needs -R or default_repo in $config" >&2
            exit 1
        fi
        item_num="${BASH_REMATCH[1]}"
        full_repo="$repo"
        url="https://github.com/$repo/issues/$item_num"
    else
        echo "Error: Invalid issue '$item'" >&2
        echo "Expected issue number or GitHub issue URL" >&2
        exit 1
    fi

    label=$(toml_get labels "$full_repo")
    labels+=("issue #$item_num from ${label:-$full_repo}")
    urls+=("$url")
done

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

for ((i = 0; i < ${#urls[@]}; i++)); do
    {
        echo "Here is the content of ${labels[i]}:"
        gh-issue-to-md "${urls[i]}"
        echo
    } >> "$tmpdir/prompt.md"
done

agent-with-input ${with_input_args[@]+"${with_input_args[@]}"} < "$tmpdir/prompt.md"
